# Local application defaults; copy this file to .env and adjust only if needed.
DATABASE_URL=sqlite:///./backend/data/history.db
MODEL_PATH=models/efficientnet_b0.pth
MODEL_VERSION=academic-experiment-1
MAX_UPLOAD_MB=8
MIN_IMAGE_DIMENSION=128
MAX_IMAGE_DIMENSION=8192
BLUR_THRESHOLD=35
DARK_THRESHOLD=35
BRIGHT_THRESHOLD=220
CONFIDENCE_THRESHOLD=0.55
ALLOW_IMAGE_RETENTION=false
RETAINED_IMAGE_DIR=backend/data/retained_images
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
